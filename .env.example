# Copy to .env and fill in. .env is gitignored.

# --- CLI runtime -------------------------------------------------------------
# Gateway API key used by `unicity-timestamp stamp`. Get one at https://sphere.unicity.network/
UNICITY_API_KEY=sk_your_gateway_key
# mainnet | testnet2
UNICITY_NETWORK=mainnet
# UNICITY_PRIVATE_KEY=<64 hex>        # optional: makes stamps signed
# UNICITY_GATEWAY_URL=https://...     # optional override
# UNICITY_TRUST_BASE=/path/to.json    # optional override
# UNICITY_TIMEOUT=60

# --- Test suite --------------------------------------------------------------
# Network tests stamp on a real network and are skipped unless this is set.
# Keep it separate from UNICITY_API_KEY so a test run never spends the production key.
# UNICITY_TEST_API_KEY=sk_your_test_key
# UNICITY_TEST_NETWORK=mainnet
